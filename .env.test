# Loaded by `bun test` at process init — the only seam early enough to beat
# Bun's proxy-env snapshot (a test preload runs too late). The Socket Firewall
# pnpm shim exports HTTP_PROXY/HTTPS_PROXY at its local MITM proxy and Bun's
# fetch honors them, so loopback fixture servers (test/fleet
# nock-loopback-passthrough) got their POSTs answered 405 by sfw. Loopback
# traffic never belongs on the firewall proxy. No secrets live here.
NO_PROXY=127.0.0.1,localhost
no_proxy=127.0.0.1,localhost
