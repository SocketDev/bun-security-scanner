{
  "ai": {
    "localAssist": true
  },
  "$schema": "./socket-wheelhouse-schema.json",
  "schemaVersion": 1,
  "repoName": "bun-security-scanner",
  "bundle": {
    "ref": "fleet-pack-3a978ecf0832e0bf45dd963a9661c4cda4074c3f",
    "cascadeSha": "3a978ecf0832e0bf45dd963a9661c4cda4074c3f"
  },
  "repo": {
    "type": "solo"
  },
  "build": {
    "from": "npm-registry",
    "type": "js"
  },
  "cover": {
    "perFileThresholds": {
      "src/index.ts": {
        "lines": 65
      }
    },
    "runner": "bun",
    "thresholds": {
      "functions": 100,
      "lines": 91
    }
  },
  "contentPolicy": {
    "class": "dual-use",
    "packages": ["."]
  },
  "vitest": {
    "nodeTestExclude": ["test/*.test.{ts,mts}", "test/modes/**"]
  }
}
