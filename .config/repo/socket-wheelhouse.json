{
  "ai": {
    "localAssist": true
  },
  "$schema": "./socket-wheelhouse-schema.json",
  "schemaVersion": 1,
  "repoName": "bun-security-scanner",
  "bundle": {
    "ref": "fleet-pack-a4da1b6d1187ebc4e2b8fc7e0659b053c965bd27",
    "cascadeSha": "a4da1b6d1187ebc4e2b8fc7e0659b053c965bd27"
  },
  "repo": {
    "type": "solo"
  },
  "build": {
    "from": "npm-registry",
    "type": "js"
  },
  "cover": {
    "perFileThresholds": {
      "src/index.mts": {
        "lines": 65
      }
    },
    "runner": "bun",
    "thresholds": {
      "functions": 100,
      "lines": 91
    }
  },
  "contentPolicy": {
    "class": "dual-use",
    "packages": ["."]
  },
  "vitest": {
    "nodeTestExclude": ["test/*.test.mts", "test/modes/**"]
  }
}
