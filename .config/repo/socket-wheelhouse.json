{
  "ai": {
    "localAssist": true
  },
  "$schema": "./socket-wheelhouse-schema.json",
  "schemaVersion": 1,
  "repoName": "bun-security-scanner",
  "bundle": {
    "ref": "fleet-pack-dcafeb6111c7f91f192d8d1843e222c8c04cc3d4",
    "cascadeSha": "dcafeb6111c7f91f192d8d1843e222c8c04cc3d4"
  },
  "repo": {
    "type": "solo"
  },
  "build": {
    "from": "npm-registry",
    "type": "js"
  },
  "cover": {
    "perFileThresholds": {
      "src/index.ts": {
        "lines": 65
      }
    },
    "runner": "bun",
    "thresholds": {
      "functions": 100,
      "lines": 91
    }
  },
  "contentPolicy": {
    "class": "dual-use",
    "packages": ["."]
  },
  "vitest": {
    "nodeTestExclude": ["test/*.test.{ts,mts}", "test/modes/**"]
  }
}
