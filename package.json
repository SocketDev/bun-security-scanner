{
  "name": "@socketsecurity/bun-security-scanner",
  "version": "1.1.3",
  "description": "Bun security scanner for SocketDev",
  "keywords": [
    "bun",
    "security"
  ],
  "license": "MIT",
  "author": "SocketDev <eng@socket.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/SocketDev/bun-security-scanner"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "DISCLOSURE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "source": "./src/index.mts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/repo/build.mts",
    "check": "pnpm run build && pnpm test",
    "clean": "node scripts/repo/clean.mts",
    "prepublishOnly": "node scripts/repo/prepublish.mts",
    "test": "bun test test/index.test.mts test/modes/authenticated.test.mts test/modes/unauthenticated.test.mts test/retired-api-token.test.mts test/scanner-bootstrap.test.mts test/dist.test.mts test/fuzz-options.test.mts test/repo/integration/gitignore.test.mts test/repo/unit/advisories.test.mts test/repo/unit/build.test.mts test/repo/unit/clean.test.mts test/repo/unit/scanner-factory.test.mts"
  },
  "devDependencies": {
    "@sinclair/typebox": "catalog:",
    "@socketregistry/packageurl-js": "catalog:",
    "@socketregistry/packageurl-js-stable": "catalog:",
    "@socketsecurity/lib": "catalog:",
    "@socketsecurity/lib-stable": "catalog:",
    "@socketsecurity/sdk": "catalog:",
    "@socketsecurity/sdk-stable": "catalog:",
    "@types/node": "catalog:",
    "bun-types": "catalog:",
    "fast-check": "catalog:",
    "nock": "catalog:",
    "rolldown": "catalog:",
    "rolldown-plugin-dts": "catalog:",
    "typescript": "catalog:"
  },
  "devEngines": {
    "packageManager": [
      {
        "name": "npm",
        "version": ">=12.2.0",
        "onFail": "error"
      },
      {
        "name": "pnpm",
        "version": ">=12.12.0",
        "onFail": "error"
      }
    ]
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "allowScripts": {
    "cpu-features": false,
    "protobufjs": false,
    "puppeteer": false,
    "ssh2": false
  },
  "contentPolicy": {
    "class": "dual-use"
  }
}
